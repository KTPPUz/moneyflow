# MySQL 8 compatible database. Add ?sslaccept=strict for cloud providers that require TLS.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/moneyflow?sslaccept=strict"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the app, e.g. https://your-app.vercel.app (locally http://127.0.0.1:3001)
BETTER_AUTH_URL=""
# Set to true after creating your account to stop new sign-ups.
AUTH_DISABLE_SIGNUP="false"
# Optional: log only API timings/status/region in Vercel Runtime Logs (no finance payload).
MONEYFLOW_LOG_TIMINGS="false"
